#!/bin/bash

source "${DOTFILES}/bash/functions/log_utils.sh"

#==============================================================================
# Description: Pick a recent Claude Code session, cd into the directory it was launched from, and
#              resume it. The listing, filtering and table live in claude_resume.py; this wrapper
#              exists because only a shell function can move your shell — a child process cannot cd
#              its parent — so the script reports the pick back through a temp file and this function
#              does the cd and the `claude --resume`. When the session exits you are left in that
#              directory.
#
# Usage: claude_resume [OPTIONS] [filter]
#
# Arguments:
#   filter - Optional search string, same as -f (matches title or directory)
#
# Options:
#   -n <count>                 How many recent sessions to list (default 25)
#   -f <str>                   Keep sessions whose title OR directory contains <str>
#   -fs, --find-session <str>  Keep sessions whose title contains <str>
#   -fd, --find-dir <str>      Keep sessions whose directory contains <str>
#   -hl, --highlight <str>     Highlight <str> in the title/directory cells without filtering anything
#   -h, --help                 Print this message
#
# See claude_resume.py for the full flag semantics (case-insensitive substrings, AND-combined).
#
# Returns:
#   0 - Resumed, or quit at the prompt
#   1 - Bad usage / no python3 / no claude binary / no sessions
#
# Examples:
#   claude_resume                        # pick from the 25 most recent sessions
#   claude_resume spark                  # title or directory contains "spark"
#   claude_resume -n 40                  # widen the list to 40
#   claude_resume -fd dotfiles           # only sessions under a dotfiles directory
#   claude_resume -n 60 -hl iceberg      # list 60 sessions, flag the ones mentioning iceberg
#==============================================================================
function claude_resume() {
  local script="${DOTFILES}/claude/functions/claude_resume.py"
  [[ -f "$script" ]] || { log_error "Session picker not found at $script"; return 1; }
  command -v python3 >/dev/null || { log_error "'python3' not found on PATH"; return 1; }

  # The pick comes back through a file so the script keeps the real terminal on stdout: colors,
  # the table and the prompt all behave as if it were running directly.
  local result
  result=$(mktemp "${TMPDIR:-/tmp}/claude_resume.XXXXXX") || { log_error "Could not create temp file"; return 1; }

  # Export the shell's current COLUMNS (bash keeps it accurate but does not export it) so the table
  # adapts to this window; the script falls back to an ioctl and then 120.
  local rc=0
  COLUMNS="${COLUMNS:-$(tput cols 2>/dev/null || echo 120)}" \
    python3 "$script" --result-file "$result" "$@" || rc=$?

  local sid="" target=""
  if (( rc == 0 )); then
    { read -r sid; read -r target; } < "$result"
  fi
  rm -f "$result"
  (( rc == 0 )) || return "$rc"
  [[ -n "$sid" ]] || return 0   # quit at the prompt

  if [[ ! -d "$target" ]]; then
    log_warn "Directory '$target' no longer exists; resuming from \$PWD ($PWD)"
  else
    cd "$target" || { log_error "Could not cd to $target"; return 1; }
  fi

  log_info "Resuming $sid in $(pwd)"
  claude --resume "$sid"
}

export -f claude_resume
