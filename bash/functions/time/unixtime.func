#!/bin/bash

source "${DOTFILES}/bash/functions/log_utils.sh"

function unixtime() {
  local __usage="
This will generate a unixtime in the specified format.

Usage: unixtime [OPTIONS]

OPTIONS:
  -f, --format <unit>   The unit type of this unixtime, defaults to 'seconds'
  -h, --help            Prints this message

EXAMPLES:

  unixtime

  unixtime -f ms

  unixtime -f nanoseconds
"

  while [[ $# -gt 0 ]]; do
    opt="$1"
    shift;
    current_arg="$1"
    if [[ "$current_arg" =~ ^-{1,2}.* ]]; then
      log_warn "You may have left an argument blank. Double check your command"
    fi
    case "$opt" in
      "-h"|"--help"   )
        echo "$__usage"
        return 1
        ;;
      "-f"|"--format" )
        local format="$1"
        shift
        ;;
      *)
        log_error "Invalid option: \"$opt\""
        return 1
        ;;
    esac
  done

  local format=${format:-s}
  local supported_formats=["s|seconds","ms|milliseconds","us|microseconds","ns|nanoseconds"]

  # Resolve the unit to a multiplier first, so the sub-second handling below is written once.
  local -i scale
  case "$format" in
    "s"|"seconds"       ) scale=1;;
    "ms"|"milliseconds" ) scale=1000;;
    "us"|"microseconds" ) scale=1000000;;
    "ns"|"nanoseconds"  ) scale=1000000000;;
    *)
      log_error "Unrecognized unixtime format: \"$format\". Supported formats: ${supported_formats[*]}"
      return 1
      ;;
  esac

  if (( scale == 1 )); then
    date +%s
  elif [[ "$(date +%N)" =~ ^[0-9]+$ ]]; then
    # GNU coreutils: %N is nine zero-padded digits, so %s%N concatenates into a clean nanosecond count.
    # Probed rather than branched on uname, matching platform_utils.sh.
    echo "$(( $(date +%s%N) / (1000000000 / scale) ))"
  else
    # BSD date has no sub-second support at all -- %N is a GNU extension and BSD emits it literally, which is
    # what fed the old `expr` a non-numeric argument. Scale whole seconds into the requested unit instead: the
    # value keeps the right magnitude and is only truncated to the second, the same trade indeed's oll/olv
    # aliases make.
    echo "$(( $(date +%s) * scale ))"
  fi
}

