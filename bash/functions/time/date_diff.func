#!/bin/bash

source "${DOTFILES}/bash/functions/log_utils.sh"
source "${DOTFILES}/bash/functions/platform_utils.sh"

function date_diff() {
  local __usage="
NAME:
  date_diff - calculate the time difference between two dates

SYNOPSIS:
  date_diff [OPTIONS] <date1> <date2>

OPTIONS:
  -h, --help       Prints this message

EXAMPLES:
  date_diff -h
  date_diff \"2023-01-01\" \"2023-01-02\"
  date_diff \"Jan 1 2023\" \"Jan 2 2023\"
"

  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "$__usage"
    return 0
  fi

  if [ $# -ne 2 ]; then
    log_error "No dates specified"
    return 1
  fi

  # epoch_from_datetime, not `date -d`: BSD date has no -d and needs an explicit input format instead.
  local epoch1 epoch2
  epoch1=$(epoch_from_datetime "$1") || return 1
  epoch2=$(epoch_from_datetime "$2") || return 1

  local res=$(( epoch1 - epoch2 ))

  res=${res#-}

  log_info "${res}s"

  # Formatted by arithmetic rather than `date -u +%H:%M:%S` on the difference: that spelling is GNU-only, and
  # it also wrapped silently at 24h, so a two-day gap printed as 00:00:00.
  printf '%02d:%02d:%02d\n' $(( res / 3600 )) $(( (res % 3600) / 60 )) $(( res % 60 ))
}

