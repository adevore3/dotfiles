#!/usr/bin/env bash

source "${DOTFILES}/bash/functions/log_utils.sh"

# Resolve the system clipboard writer: pbcopy on macOS, wl-copy on Wayland, xclip on X11. Prints the command
# *string* to run -- callers must expand it unquoted, since "xclip -selection c" has to word-split into a
# program plus two arguments. Prints nothing when no tool is available.
function _system_clipboard_command() {
  # pbcopy first: it is always present on macOS, and a mac that also has Homebrew's xclip still wants pbcopy.
  if command -v pbcopy >/dev/null 2>&1; then
    echo "pbcopy"
  # wl-copy only inside a real Wayland session. It is frequently installed on X11 boxes too, where it just
  # exits with "failed to connect to a Wayland server"; xclip meanwhile still works under Wayland through
  # XWayland. So gating the native tool on WAYLAND_DISPLAY and falling through to xclip is correct on both.
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1; then
    echo "wl-copy"
  elif command -v xclip >/dev/null 2>&1; then
    echo "xclip -selection c"
  # Last resort: wl-copy exists but WAYLAND_DISPLAY is unset, e.g. a cron or systemd context that dropped it.
  # Better to try it and let it fail loudly than to report no clipboard at all.
  elif command -v wl-copy >/dev/null 2>&1; then
    echo "wl-copy"
  fi
}

# Refuse a FILE list that cannot be read in full, before a single byte reaches the clipboard. Letting cat
# fail mid-pipeline still hands the clipboard whatever it managed to emit, so one bad path clobbers the
# clipboard with partial content on the way to returning 1 -- a typo would destroy what you were holding. A
# directory counts as unreadable here: cat rejects it and copies nothing, which wipes the clipboard just as
# thoroughly.
function _clipboard_files_readable() {
  local file
  for file in "$@"; do
    if [ -d "$file" ]; then
      log_error "cannot copy $file: is a directory"
      return 1
    fi

    if [ ! -r "$file" ]; then
      log_error "cannot read $file"
      return 1
    fi
  done
}

# Copy stdin -- or the contents of any FILE arguments -- to the system clipboard, echoing nothing back. The
# portable stand-in for a bare `xclip -sel clip`, which only exists on Linux/X11.
# shellcheck disable=SC2120  # FILE arguments arrive from the `xclipf` alias, which shellcheck cannot see
function clipboard_write() {
  local clip
  clip="$(_system_clipboard_command)"

  if [ -z "$clip" ]; then
    log_warn "no clipboard command found (install xclip, or wl-clipboard on Wayland; macOS uses pbcopy)"
    return 1
  fi

  if (( $# == 0 )); then
    $clip
    return $?
  fi

  _clipboard_files_readable "$@" || return 1

  # cat does the reading rather than the clipboard tool, because only xclip accepts file arguments: pbcopy
  # rejects them and wl-copy would copy the path text itself. Forwarding "$@" would be a silent wrong-content
  # copy on two of the three platforms.
  local statuses
  cat -- "$@" | $clip
  statuses=("${PIPESTATUS[@]}")
  (( statuses[0] == 0 )) || return "${statuses[0]}"
  return "${statuses[1]}"
}

function save_to_clipboard() {
  local __usage="
NAME:
  save_to_clipboard - read from stdin, save to clipboard and output to stdout

SYNOPSIS
  save_to_clipboard [OPTIONS]... [FILE]...

OPTIONS:
  -h, --help       Prints this message
  -q, --quiet      Saves to standard clipboard & suppresses output

EXAMPLES:
  save_to_clipboard -h

  echo hello world | save_to_clipboard

  echo hello world | save_to_clipboard -q

  save_to_clipboard notes.txt

  save_to_clipboard -q notes.txt
"

  # Options first, so whatever is left is the FILE list. Parsing used to sit inside an else branch reached
  # only when there was at least one argument, which left a bare `save_to_clipboard <file>` matching nothing
  # and returning 0 without copying or printing a thing.
  while [[ "${1:-}" =~ ^-{1,2}.* ]]; do
    opt="$1"
    shift;
    current_arg="${1:-}"
    if [[ ! "$opt" =~ ^(-h|--help)$ ]] && [[ "$current_arg" =~ ^-{1,2}.* ]]; then
      log_warn "You may have left an argument blank. Double check your command"
      return 1
    fi

    case "$opt" in
      "-h"|"--help")
        echo "$__usage"
        return 1;;
      "-q"|"--quiet")
        # Delegates rather than repeating the resolve-and-warn below; -q is exactly clipboard_write, including
        # its FILE handling. Returns its status, so a successful copy exits 0 -- this used to `return 1` even
        # after writing, which made `... | stcq && echo copied` unusable.
        clipboard_write "$@"
        return $?;;
      *)
        log_error "Invalid option: \"$opt\""
        return 1;;
    esac
  done

  # Resolved after the usage text so -h/--help still works on a host with no clipboard tool at all.
  local clip
  clip="$(_system_clipboard_command)"

  if [ -z "$clip" ]; then
    log_warn "no clipboard command found (install xclip, or wl-clipboard on Wayland; macOS uses pbcopy)"
    if (( $# == 0 )); then
      cat
    else
      cat -- "$@"
    fi
    return 1
  fi

  # No FILE arguments means stdin, and `cat --` with no operands would read stdin anyway -- but only where
  # cat's getopt swallows the `--`, which is not worth betting the mac on.
  if (( $# == 0 )); then
    tee >($clip) < /dev/stdin
    return $?
  fi

  _clipboard_files_readable "$@" || return 1

  # Same contract either way: copy it, and still print it. cat reads the files for the same reason
  # clipboard_write does not hand them to the clipboard tool directly.
  local statuses
  cat -- "$@" | tee >($clip)
  statuses=("${PIPESTATUS[@]}")
  (( statuses[0] == 0 )) || return "${statuses[0]}"
  return "${statuses[1]}"
}

