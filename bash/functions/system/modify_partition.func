#!/bin/bash

source "${DOTFILES}/bash/functions/log_utils.sh"
source "${DOTFILES}/bash/functions/platform_utils.sh"

function modify_partition() {
  local __usage="
NAME:
  modify_partition - Modify the start & end date in a file by the specified
                     partition. By default it increments the partition value
                     by 1 for a file named run.sh

SYNOPSIS
  modify_partition [OPTIONS]...

OPTIONS:
  -h, --help       Prints this message
  -y, --year       Modify the year of the start/end date
  -m, --month      Modify the month of the start/end date
  -d, --day        Modify the day of the start/end date
  -hh, --hour      Modify the hour of the start/end date
  --increase       Increase the selected partition of the start/end date by a given amount
  --decrease       Decrease the selected partition of the start/end date by a given amount
  -f, --file       Specify file, defaults to run.sh

EXAMPLES:
  modify_partition -h

  # List start and end date, 1 at a time, and let user specify which partition to increment by 1
  modify_partition

  # Increment the year by 1 for both the start/end date
  modify_partition -y

  # Increase hour partition by a given amount
  modify_partition -hh --increase 10

  # Decrease partition by a given amount, lets user specify which partition
  modify_partition --decrease 10

  # Specify file name
  modify_partition -d -f run_custom.sh

NOTES:
  Runs on Linux and macOS. All date and sed handling goes through platform_utils, so no GNU-only spelling is
  left -- see the comment on update_date for the three that used to be here.
"

  local modify_operator=increase
  local update_amount=1
  local file=run.sh
  while [[ "$1" =~ ^-{1,2}.* ]]; do
    opt="$1"

    case "$opt" in
      "-h"|"--help")
        echo "$__usage"
        return 0
        ;;
      "-y"|"--year")
        local selected_partition=year
        shift
        ;;
      "-m"|"--month")
        local selected_partition=month
        shift
        ;;
      "-d"|"--day")
        local selected_partition=day
        shift
        ;;
      "-hh"|"--hour")
        local selected_partition=hour
        shift
        ;;
      "--inc"|"--increase")
        shift
        local update_amount=$1
        shift
        ;;
      "--dec"|"--decrease")
        modify_operator=decrease
        shift
        local update_amount=$1
        shift
        ;;
      "-f"|"--file")
        shift
        file=$1
        shift
        ;;
      *)
        log_error "Invalid option: \"$opt\""
        return 1
        ;;
    esac
  done


  # No partition selected means no unit to shift by, and the old code did not check: `date -d "<date> + 1 "` fails,
  # $new_date ends up empty, and GNU sed then writes that empty string over the real date. Running this with no
  # flag deleted both dates outright. Checked here rather than defaulting to one, since guessing which partition
  # was meant is worse than saying so.
  if [ -z "${selected_partition:-}" ]; then
    log_error "modify_partition: no partition selected; pass one of -y/-m/-d/-hh (see --help)"
    return 1
  fi

  if [ ! -f "$file" ]; then
    log_error "Expected file '$file' to exist"
    return 1
  fi

  function update_date() {
    local search_str=$1

    # grep -F, not fgrep: GNU grep 3.8+ prints an obsolescence warning to stderr for the latter.
    date_str=$(grep -F -- "$search_str" "$file" | cut -d= -f2)
    regex="([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2}"


    if [[ "$date_str" =~ $regex ]]; then
      local original_date="${BASH_REMATCH[0]}"

      case "$modify_operator" in
        "increase")
          local operator_symbol="+"
          ;;
        "decrease")
          local operator_symbol="-"
          ;;
        *)
          log_error "Invalid operator: \"$modify_operator\""
          return 1
          ;;
      esac

      # This one line held every GNU-only spelling in the function: relative arithmetic through `date -d`, which
      # BSD spells `-v+1m`, and `%:z`, which BSD does not have at all -- it emits a literal ":z" and exits 0, so
      # asking for it there produced corrupt output rather than an error. date_shift and utc_offset_colon cover
      # both. Shifting to an epoch first keeps the two calls pinned to one instant, and is the only portable way
      # to get a colon offset, since `%z` is portable and `%:z` is not.
      #
      # TZ stays pinned on each call, as before: the base carries -06:00 and relative units resolve in the
      # current zone, so the two have to agree or a month's shift lands an hour out.
      local epoch new_date
      local adjustment="${operator_symbol}${update_amount} ${selected_partition}"
      if ! epoch=$(TZ=UTC+6 date_shift "$original_date" "$adjustment" '%s'); then
        log_error "Could not shift $search_str '$original_date' by '$adjustment'"
        return 1
      fi
      new_date="$(TZ=UTC+6 date_from_epoch "$epoch" '%Y-%m-%dT%H:%M:%S')$(TZ=UTC+6 utc_offset_colon "$epoch")"

      # Nothing malformed reaches sed. This edits the file in place, so an empty $new_date would replace the real
      # date with nothing -- which is exactly what used to happen. Held in a variable: bash 3.2 reads a quoted
      # =~ operand as a literal string.
      local new_date_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$'
      if [[ ! "$new_date" =~ $new_date_re ]]; then
        log_error "Refusing to write a malformed $search_str date: '$new_date'"
        return 1
      fi

      log_info "old $search_str $original_date"
      log_info "new $search_str $new_date"

      sed_in_place "s/$search_str\"$original_date/$search_str\"$new_date/g" "$file"

    else
      log_error "Could not find a '$search_str' string"
    fi
  }

  update_date "start="
  update_date "end="
}

