#!/usr/bin/env bash

source "${DOTFILES}/bash/functions/log_utils.sh"

#==============================================================================
# Description: List listening TCP/UDP sockets with the owning process.
#
#              The `netstat -tulanp` this replaces is Linux-only: BSD/macOS netstat has no -t/-u/-p and
#              cannot report the owning process at all, so lsof is the equivalent there.
#
# Usage: list_listening_ports
#
# Returns:
#   0 - Success
#   1 - No supported tool available
#
# Example:
#   list_listening_ports    # aliased to `ports`
#==============================================================================
function list_listening_ports() {
  local __usage="
NAME:
  list_listening_ports - list listening TCP/UDP sockets with the owning process

SYNOPSIS
  list_listening_ports [OPTIONS]

OPTIONS:
  -h, --help       Prints this message

EXAMPLES:
  list_listening_ports -h
  list_listening_ports
"

  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    echo "$__usage"
    return 0
  fi

  case "$(uname -s)" in
    Linux)
      # ss where available; netstat's -p is deprecated on modern distros and net-tools is often absent.
      if command -v ss >/dev/null 2>&1; then
        sudo ss -tulanp
      else
        sudo netstat -tulanp
      fi
      ;;
    Darwin)
      # lsof, not netstat: macOS netstat cannot attribute a socket to a process.
      sudo lsof -nP -iTCP -sTCP:LISTEN +c 0
      ;;
    *)
      log_error "list_listening_ports: unsupported platform '$(uname -s)'"
      return 1
      ;;
  esac
}
